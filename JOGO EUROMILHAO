<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Gerador EuroMilhões</title>
  <link rel="stylesheet" href="style.css" />
  <link rel="manifest" href="manifest.json" />
</head>
<body>
  <h1>Gerador EuroMilhões com IA e Peso</h1>
  <button id="gerarBtn">Gerar sequência</button>
  <div id="sequencia"></div>

  <script src="script.js"></script>
</body>
</html>
 
body {
  font-family: Arial, sans-serif;
  padding: 20px;
  background: #f9f9f9;
  text-align: center;
}

h1 {
  color: #333;
}

#gerarBtn {
  font-size: 18px;
  padding: 10px 20px;
  margin: 20px 0;
  cursor: pointer;
}

#sequencia {
  margin-top: 20px;
  font-size: 24px;
  color: #007acc;
  user-select: none;
}
// Pesos baseados na frequência dos números fornecidos (mais usados tem peso maior)
const pesos = {
  1: 3, 2: 4, 4: 1, 5: 1, 6: 1, 7: 3, 8: 4, 9: 1, 10: 3,
  11: 1, 12: 1, 13: 1, 15: 1, 16: 2, 17: 1, 18: 1, 19: 3,
  21: 1, 23: 3, 24: 3, 25: 2, 26: 1, 27: 1, 28: 1, 29: 2,
  30: 1, 32: 2, 33: 1, 34: 1, 36: 2, 38: 1, 39: 1, 41: 2,
  42: 3, 44: 1, 45: 4, 46: 1, 48: 1, 49: 3, 50: 1
};

function getRandomWeightedNumber(min, max, excluded) {
  let weightedNumbers = [];
  for (let i = min; i <= max; i++) {
    if (excluded.includes(i)) continue;
    const weight = pesos[i] || 1;
    for (let w = 0; w < weight; w++) {
      weightedNumbers.push(i);
    }
  }
  return weightedNumbers[Math.floor(Math.random() * weightedNumbers.length)];
}

document.getElementById('gerarBtn').addEventListener('click', () => {
  let numeros = [];
  let estrelas = [];

  // Gerar 5 números únicos de 1 a 50
  while (numeros.length < 5) {
    let n = getRandomWeightedNumber(1, 50, numeros);
    if (!numeros.includes(n)) numeros.push(n);
  }
  numeros.sort((a, b) => a - b);

  // Gerar 2 estrelas únicas de 1 a 12
  while (estrelas.length < 2) {
    let e = getRandomWeightedNumber(1, 12, estrelas);
    if (!estrelas.includes(e)) estrelas.push(e);
  }
  estrelas.sort((a, b) => a - b);

  document.getElementById('sequencia').textContent = 
    `Números: ${numeros.join(' ')} + Estrelas: ${estrelas.join(' ')}`;
});
{
  "name": "Gerador EuroMilhões",
  "short_name": "EuroMilhões",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#007acc",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
self.addEventListener('install', (e) => {
  e.waitUntil(
    caches.open('v1').then((cache) => cache.addAll([
      './',
      './index.html',
      './style.css',
      './script.js',
      './manifest.json',
      './icon-192.png',
      './icon-512.png'
    ]))
  );
});

self.addEventListener('fetch', (e) => {
  e.respondWith(
    caches.match(e.request).then((response) => response || fetch(e.request))
  );
});
